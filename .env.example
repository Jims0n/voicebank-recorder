DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Postgres in production, SQLite locally if unset
DATABASE_URL=
# Set USE_S3=1 to store audio in S3-compatible storage (Cloudflare R2 / AWS S3)
USE_S3=0
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=auto
# Bump this whenever the consent text changes
CONSENT_VERSION=v1
